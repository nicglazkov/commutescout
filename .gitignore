# OS
.DS_Store

# Private planning docs - never commit anything in this directory
docs-private/

# Secrets and local environment
.env
.env.*
*.local.json
credentials*.json
service-account*.json

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Eval raw results are artifacts, not source (badge.json is kept)
evals/results/results-*.json

# Agent scratch: task ledgers, briefs, and review diffs. Never source.
# A `git add -A` committed 11 of these once; the directory was assumed
# to be ignored and was not.
.superpowers/

# Node site workspace build outputs
site/node_modules/
site/out/
site/.next/

# Docker's COPY destination for the built site/out export (see SITE_DIR
# in src/ca_roads_demo/app.py); nothing populates this outside the Docker
# build, so it must never be committed.
src/ca_roads_demo/static/site/
uv.lock
