rules_version = '2';

// The database is reached ONLY by this project's server via the
// service-account SDK, which bypasses these rules. No client (browser,
// mobile, anyone holding the public Firebase web API key) is ever
// allowed to read or write directly. Deployed to the cloud.firestore
// release; keep it deny-all.
//
// Account records (watch_users/{uid}) include fields that must only
// ever be written by the server after verifying the caller's ID token:
// terms_version / terms_accepted_at (the Terms of Use and Privacy
// Policy agreed to at sign-in, POST /api/me/terms, time stamped by the
// server) and plugins.ack (per plugin, that the person acknowledged
// an unreviewed plugin's alerts come from its operator, PUT
// /api/me/plugins, also stamped by the server). A client-writable rule
// here would let anyone forge either, which is one more reason this
// stays deny-all.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
