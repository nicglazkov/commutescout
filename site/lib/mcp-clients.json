{
  "endpoint": "https://mcp.commutescout.com/mcp",
  "key_header": "Authorization: Bearer cs_live_...",
  "key_placeholder": "cs_live_...",
  "personal_url": "https://mcp.commutescout.com/mcp/cs_live_...",
  "link_note": "Your link contains your key, so keep it private like a password. If it leaks, delete the key under Settings > API keys on the map and make a new one.",
  "clients": [
    {
      "id": "chatgpt",
      "name": "ChatGPT",
      "short": "ChatGPT",
      "hint": "chatgpt.com and apps",
      "key": true,
      "steps": [
        {
          "text": "On chatgpt.com, open Plugins, choose +, then Add custom MCP server."
        },
        {
          "text": "Name: CommuteScout. URL: your personal link. Authentication: No authentication (the key is in the link)."
        },
        {
          "lang": "text",
          "code": "https://mcp.commutescout.com/mcp/cs_live_..."
        },
        {
          "text": "Save, then ask about a drive in a new chat. Menu names can differ slightly between ChatGPT versions and plans."
        }
      ]
    },
    {
      "id": "claude-ai",
      "name": "Claude",
      "short": "Claude",
      "hint": "claude.ai and apps",
      "key": true,
      "steps": [
        {
          "text": "Open Customize > Connectors > + Add > Add custom connector."
        },
        {
          "text": "Name: CommuteScout. URL: your personal link. Sign-in: No sign in (the key is in the link)."
        },
        {
          "lang": "text",
          "code": "https://mcp.commutescout.com/mcp/cs_live_..."
        },
        {
          "text": "Choose Add. The connector then appears in Claude Desktop and the mobile apps too. On Team and Enterprise plans an owner adds it first under Organization settings > Connectors."
        }
      ]
    },
    {
      "id": "claude-code",
      "name": "Claude Code",
      "short": "Claude Code",
      "hint": "Terminal",
      "key": true,
      "steps": [
        {
          "lang": "sh",
          "code": "claude mcp add --transport http --scope user commutescout https://mcp.commutescout.com/mcp/cs_live_..."
        },
        {
          "text": "Run /mcp inside Claude Code to confirm it connected."
        }
      ]
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "short": "Cursor",
      "hint": "One click",
      "key": true,
      "install": "cursor",
      "steps": [
        {
          "text": "Use Add to Cursor, or add this to ~/.cursor/mcp.json:"
        },
        {
          "lang": "json",
          "code": "{\n  \"mcpServers\": {\n    \"commutescout\": {\n      \"url\": \"https://mcp.commutescout.com/mcp/cs_live_...\"\n    }\n  }\n}"
        }
      ]
    },
    {
      "id": "vscode",
      "name": "VS Code (GitHub Copilot)",
      "short": "VS Code",
      "hint": "One click",
      "key": true,
      "install": "vscode",
      "steps": [
        {
          "text": "Use Add to VS Code, or run MCP: Add Server from the Command Palette, choose HTTP, and paste your personal link:"
        },
        {
          "lang": "text",
          "code": "https://mcp.commutescout.com/mcp/cs_live_..."
        }
      ]
    },
    {
      "id": "codex",
      "name": "OpenAI Codex CLI",
      "short": "Codex CLI",
      "hint": "Terminal",
      "key": true,
      "steps": [
        {
          "lang": "sh",
          "code": "codex mcp add commutescout --url https://mcp.commutescout.com/mcp/cs_live_..."
        }
      ]
    },
    {
      "id": "gemini",
      "name": "Gemini CLI",
      "short": "Gemini CLI",
      "hint": "Terminal",
      "key": true,
      "steps": [
        {
          "lang": "sh",
          "code": "gemini mcp add --transport http commutescout https://mcp.commutescout.com/mcp/cs_live_..."
        }
      ]
    },
    {
      "id": "windsurf",
      "name": "Windsurf",
      "short": "Windsurf",
      "hint": "Config file",
      "key": true,
      "steps": [
        {
          "text": "Add to its mcp_config.json (MCP settings > View raw config):"
        },
        {
          "lang": "json",
          "code": "{\n  \"mcpServers\": {\n    \"commutescout\": {\n      \"serverUrl\": \"https://mcp.commutescout.com/mcp/cs_live_...\"\n    }\n  }\n}"
        }
      ]
    },
    {
      "id": "other",
      "name": "Any other MCP client",
      "short": "Other",
      "hint": "Any MCP client",
      "key": true,
      "steps": [
        {
          "text": "Point the client at your personal link (streamable HTTP, stateless, no OAuth sign-in):"
        },
        {
          "lang": "text",
          "code": "https://mcp.commutescout.com/mcp/cs_live_..."
        },
        {
          "text": "Or use https://mcp.commutescout.com/mcp and send the key on every request as Authorization: Bearer cs_live_... (or X-API-Key: cs_live_...). A client that only speaks stdio can bridge with:"
        },
        {
          "lang": "sh",
          "code": "npx mcp-remote https://mcp.commutescout.com/mcp/cs_live_... --transport http-only"
        }
      ]
    }
  ]
}
